# ============ 密钥 / 环境（绝不提交） ============
# 真实管理员口令 + LangSmith Key 都在这里，泄露即安全事故
site/server/.env
*.env
.env
.env.local

# 会话令牌 HMAC 签名密钥（服务端自动生成，缺失会自动重建）
site/server/data/.app_secret

# 本地测试用 LLM Key（deepseek / 通义百炼），绝不入库
apikey.txt

# ============ 依赖 ============
node_modules/
site/node_modules/
site/server/node_modules/

# ============ 构建产物（由 npm run build 生成） ============
site/dist/
dist/
# 构建前临时挪出的旧 dist（mv dist dist_bak 绕过回收站钩子用），非源码
site/dist_bak/

# ============ 运行时数据 / 数据库 ============
# ⚠️ templates.json 是源码语料种子，需保留；下面只排除运行时产物
site/server/data/app.db
site/server/data/app.db-wal
site/server/data/app.db-shm
site/server/data/lancedb/
site/server/data/backups/

# ============ 日志 ============
*.log
logs/

# ============ 工具记忆（非源码） ============
.workbuddy/

# ============ 系统 / 编辑器 ============
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ============ 内部文档 / 生成产物（不公开，仅本地保留） ============
# 产品需求、Agent 架构等内部规划文档，不进公开仓库
PRD-提示词模板框架站.md
ARCH-agent.md
# 评测跑出来的报告（会重生成，不进版本库；eval_chain_report.md 同理未跟踪）
site/server/scripts/eval_rag_report.md
site/server/scripts/eval_chain_report.md

# ============ 本地杂项 / 生成产物（不进版本库） ============
# 功能验证用的截图脚本与图片，非源码
shot_*
# 竞品监控自动化生成的报告（会重生成）
report-*.md
# 根目录遗留的孤儿锁文件（无对应 package.json）
/package-lock.json
# 未引用的根目录种子数据残留
cl.json
