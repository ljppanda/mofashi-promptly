# 复制本文件为 .env 并填入真实值后重启服务即可生效。
# .env 已被根目录 .gitignore 忽略，不会被提交到 git / GitHub。
# 所有项均可留空使用内置默认值；带「部署必填」的项是公网发布时建议显式配置。

# ---------- 服务端口 / 数据库 ----------
# 监听端口（默认 8000）
# PORT=8000
# 数据库文件路径（默认 site/server/data/app.db；测试 / 多实例隔离时可改）
# APP_DB_FILE=./data/app.db
# 会话令牌 HMAC 签名密钥（留空 = 自动生成 data/.app_secret；设固定值可跨重启保持会话有效）
# APP_SECRET=

# ---------- 跨域（CORS）白名单 ----------
# 默认同源收紧（前端同域无需设）。单独部署前端、或经反代时填前端源，逗号分隔：
# APP_CORS_ORIGIN=https://your-domain.com

# ---------- 鉴权（管理员口令） ----------
# 留空 = 每次重启自动生成临时口令（控制台打印，重启即变）
# 设固定值 = 重启后口令恒定，可用于后台（审核台 / 公开下架 / metrics 重置）稳定登录
# APP_ADMIN_PASSPHRASE=

# ---------- 邮箱密码重置（Resend）【部署必填：公网发布要真发信】 ----------
# 三项都不填 → dev 降级：重置链接只打印到服务端日志并落盘 data/dev-reset-links.log（本地 / 自测用）
# Resend API Key（纯 fetch 发信，无需装包）：https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# 发件人（缺省 onboarding@resend.dev；生产建议用已验证的自己域名邮箱，如 noreply@your-domain.com）
# RESEND_FROM=onboarding@resend.dev
# 站点公网地址（用于拼接重置链接 https://<站点>/?token=...；不填则按请求 host 推断，反代 / 负载均衡下建议显式设）
# APP_PUBLIC_URL=https://your-domain.com

# ---------- 限流（内存固定窗口，默认已给生产友好值） ----------
# 全局：每 60s 最多请求数
# RL_GLOBAL_LIMIT=240
# 注册：每 3600s（1h）最多次数
# RL_REGISTER_LIMIT=5
# 忘记密码：每 3600s（1h）最多次数（枚举防护）
# RL_FORGOT_LIMIT=5
# /relay 转发：每 60s 最多次数
# RL_RELAY_LIMIT=30

# ---------- LLM 韧性（指数退避重试 + 主备切换） ----------
# 单次请求最大重试次数（仅可重试错误：5xx / 网络错误）
# LLM_MAX_RETRIES=2
# 重试基准退避毫秒
# LLM_RETRY_BASE_MS=400
# 重试最大退避毫秒
# LLM_RETRY_MAX_MS=8000
# 主备 provider 列表（格式 provider:model，逗号分隔；服务端持有备用 Key 时启用）
# LLM_FALLBACK_PROVIDERS=openrouter:openai/gpt-4o, deepseek:deepseek-chat
# 备用 provider 的 Key / Secret（与上面列表一一对应）
# LLM_FALLBACK_API_KEY=sk-xxxx
# LLM_FALLBACK_API_SECRET=

# ---------- 社区 AI 审核（公网建议开启） ----------
# 留空 = 关键词兜底审核（离线，无需 Key）
# MODERATION_PROVIDER=deepseek      # 用 deepseek / openai / openrouter 等做语义审核
# MODERATION_API_KEY=sk-xxxx
# MODERATION_API_SECRET=
# MODERATION_MODEL=deepseek-chat
# MODERATION_PROXY=                  # 可选：代理基址（国内访问海外模型用）
# 设为 1 完全关闭审核（不推荐公网）
# MODERATION_DISABLED=0

# ---------- 可观测：Sentry 错误聚合（可选） ----------
# 仅设则启用；留空不启用
# SENTRY_DSN=

# ---------- 日志格式 ----------
# text = 人类可读；json = JSON 行（便于采集到 Loki / ELK 等）
# LOG_FORMAT=text

# ---------- LangSmith 可观测（可选，云端 trace） ----------
# 留空 = 仅使用本地 #/traces 面板，不向云端上报。
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=模法师-Promptly
# 自定义接入点（默认 https://api.smith.langchain.com）
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- RAG 语义检索（默认关；开启后首次需联网下载模型） ----------
# 语义召回：设为 1 启用本地 bge 语义向量（弥补纯词法「同义不同字」召回弱）
#   ⚠️ 首次启用会从 HuggingFace 下载模型；下载失败自动回退纯词法
#   🇨🇳 国内下载慢/被墙可设镜像：HF_ENDPOINT=https://hf-mirror.com
# RAG_EMBEDDING=1
# RAG_EMBEDDING_MODEL=Xenova/bge-base-zh-v1.5
# RAG_RERANKER=1
# RAG_RERANKER_MODEL=Xenova/bge-reranker-v2-m3

# ---------- SSRF 白名单扩展（/relay 转发） ----------
# 默认仅放行内置 LLM 厂商公网域名；如需放行额外自建域名（逗号分隔）：
# RELAY_EXTRA_HOSTS=api.your-self-hosted.com
